---
import { Image } from 'astro:assets';
import avatarImage from "/src/assets/images/avatar.jpg"

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import CoreHtml from '../layouts/CoreHtml.astro';
import FacetsString from '../components/MainPage/FacetsString.astro';
// Fetch and sort blog posts
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Fetch and sort blog posts
const allProjects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentProjects = allProjects.slice(0, 4);
 
const recentPosts = allPosts.slice(0, 4); 
---


<CoreHtml>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="flex flex-col gap-36 mt-36">
				<div class="flex-1 min-w-0 [font-family:'Comfortaa'] text-[.9em]">
					<!-- ! Avatar hidden until I decide whether to use it and how. -->
					<div class="hidden flex flex-nowrap items-center mb-0">
						<!-- `container-type:inline-size` is used to correctly calculate `translateY` value for the segment lines. -->
						<!-- Use css variable for avatar size. -->
						<div class="shrink-0 inline-block relative mr-4 [container-type:inline-size] [--avatar-size:64px] sm:[--avatar-size:84px] w-[var(--avatar-size)] h-[var(--avatar-size)] ">
							<div id="avatar" class="transition-transform duration-2000 ease-in-out w-full h-full relative select-none">
								<Image class="inline-block w-[var(--avatar-size)] h-[var(--avatar-size)] rounded-full" alt="Mycolaos photoshot elaborated in Borderlands style" src={avatarImage} />
									{Array.from({ length: 16 }).map((_, i) => (
										<span
											class="avatar-segment absolute block bg-black transform-3d"
											style={{
												// 2πr/16 ≈ 18.85 for r=48px (48px is an example). + 3px to cover empty space created by the angle.
												width: 'calc(calc(calc(pi * 100%) / 16) + 3px)',
												// Segment thickness.
												height: '3px', 
												// Position at half of the container.
												left: '50%', 
												top: '50%',
												// 1. Translate to position centrally relative to the avatar.
												// 2. Rotate segment to its angle.
												// 3. After rotation, translateY away from center, 
												// the Y has now an angle created by the previous rotation.
												// Use `cqw` units for correct distance. 
												// Can't use percentages because translate % is relative to the element itself, not to the parent.
												transform: `translate(-50%, -50%) rotate(${i * 22.5}deg) translateY(-50cqw)`,
												borderRadius: '2px',
											}}
										></span>
									))}
							</div>
						</div>
					</div>
					<div class="">
						<p class="inline">I'm <span >Mycolaos</span>, <FacetsString /></p>
					</div>
					<p>
						It's my little digital corner. Sometimes I write, or build an experiment or a bigger project.
					</p>
				</div>
				
				<aside class="flex flex-col gap-8">
					<!-- Projects -->
					<div>
						<h3 class="text-sm m-0 font-bold mb-2">Projects</h3>
						<ul class="space-y-0 list-none m-0">
							{recentProjects.map((project) => (
								<li class="mb-2 last:mb-0">
									<a href={`/projects/${project.id}/`}>
										<h4 class="m-0 text-xs leading-tight hover:text-primary-dark">{project.data.title}</h4>
									</a>
								</li>
							))}
						</ul>
						<a href="/projects/" class="inline-block text-xs font-bold hover:text-primary-dark">
							More →
						</a>
					</div> 

					<!-- Writings -->
					<div>
						<h3 class="text-sm m-0 font-bold mb-2">Writings</h3>
						<ul class="space-y-0 list-none m-0">
							{recentPosts.map((post) => (
								<li class="mb-2 last:mb-0">
									<a href={`/blog/${post.id}/`}>
										<h4 class="m-0 text-xs leading-tight hover:text-primary-dark">{post.data.title}</h4>
									</a>
								</li>
							))}
						</ul>
						<a href="/blog/" class="inline-block text-xs font-bold hover:text-primary-dark">
							More →
						</a>
					</div> 
				</aside>
			</div>
		</main>
		
		<Footer />
	</body>
</CoreHtml>
<style>

#avatar {
	perspective: 600px;
	transform-style: preserve-3d;
	will-change: transform;
}
#avatar.rotate {
	transform: rotateY(180deg);
}
.avatar-segment {
	/* The color is set via bg-primary-dark, but you can override here if needed */
	pointer-events: none;
	z-index: 2;
	transition: background 0.2s;
}

.avatar-segment {
	pointer-events: none;
	z-index: 2;
	transition: background 0.2s;
	position: absolute;
}
.avatar-segment::after {
	content: '';
	display: block;
	position: absolute;
	background: black;
	inset: 0;
	bottom: 100%;
	top: -5px;
	border-radius: 2px;
	transform: rotateX(90deg);
	transform-origin: bottom;
} 
</style>
<script>
	// Avatar rotation
	const avatar = document.getElementById('avatar');
	avatar?.addEventListener('click', () => {
		avatar.classList.toggle('rotate');
	});
</script>