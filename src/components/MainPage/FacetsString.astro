<span id="facets-list" aria-live="polite" aria-atomic="true" role="button" class={
  "list-none inline m-0 cursor-pointer text-primary select-none " + 
  "[&_span]:text-[1em] [&_span]:hidden [&>[aria-current=true]]:inline"}>
  <span aria-current="true">a Frontend Engineer</span>
  <span>a little bit Fullstack</span>
  <span>I love design, but I'm not a designer</span>
  <span>I prefer owning a project, but love cooperating</span>
  <span>an amateur BBJ practioner</span>
  <span>I like working out outside</span>
</span>
<script>
  document.addEventListener("astro:page-load", () => {
    const facetsList = document.getElementById('facets-list');

    if (!facetsList) {
      return;
    }

    facetsList.addEventListener('click', () => {      
      const current = facetsList.querySelector('[aria-current=true]');
      const next = current?.nextElementSibling || facetsList.firstElementChild;
      current?.removeAttribute('aria-current');
      next?.setAttribute('aria-current', 'true')
    })
  });
</script>